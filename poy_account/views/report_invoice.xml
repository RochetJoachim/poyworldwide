<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="poy_report_invoice_document_custom" inherit_id="account.report_invoice_document">
        <xpath expr="//th[@name='th_taxes']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//td[@name='td_taxes']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//th[@name='th_quantity']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//t[@name='account_invoice_line_accountable']/td[2]" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//th[@name='th_subtotal']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//td[contains(@class, 'o_price_total')]" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//th[@name='th_priceunit']/span" position="replace">
            <span>PRICE</span>
        </xpath>
    </template>
</odoo>